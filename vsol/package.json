{
  "name": "@vsol/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:program": "anchor build",
    "test:rust": "npm run build:program && cargo test --workspace --all-targets",
    "test:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:sdk": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test:rust && npm run test:lint && npm run test:sdk",
    "devnet:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "devnet:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-deployment.ts",
    "keeper": "node --env-file-if-exists=.env --import tsx scripts/keeper.ts",
    "cranker": "node --env-file-if-exists=.env --import tsx scripts/cranker.ts",
    "lookup-table": "node --env-file-if-exists=.env --import tsx scripts/create-lookup-table.ts",
    "test:rust:only": "cargo test --workspace --all-targets",
    "prove:complete-set": "node --env-file-if-exists=.env --import tsx scripts/prove-complete-set.ts",
    "prove:redeem": "node --env-file-if-exists=.env --import tsx scripts/prove-redeem-winning.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@coral-xyz/anchor": "0.29.0",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@pythnetwork/solana-utils": "0.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "bn.js": "5.2.5",
    "jayson": {
      "uuid": "11.1.1"
    },
    "rpc-websockets@^7.5.1": {
      ".": "7.5.1",
      "uuid": "11.1.1"
    }
  }
}
