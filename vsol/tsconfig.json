{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["sdk/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "target/types/**/*.ts"],
  "exclude": ["scripts/dev-rpc-proxy.ts", "scripts/http-flow-smoke.ts", "scripts/web-execution-smoke.ts"]
}
