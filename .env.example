# Devnet-only isolated signers. Use JSON byte arrays or base64-encoded JSON.
# Never use a mainnet, admin, or personally funded wallet here.
VSOL_MAKER_SECRET_KEY=
VSOL_FAUCET_SECRET_KEY=
VSOL_RPC_URL=https://your-private-devnet-rpc.example

# Off-chain market data (spot reference, realized volatility, chart bars) --
# see app/lib/market-data.ts. Defaults to "coinbase" (no key required).
# Onchain SETTLEMENT always verifies Pyth regardless of this setting.
MARKET_DATA_PROVIDER=coinbase

# Only read when MARKET_DATA_PROVIDER=pyth. Pyth Core Hermes supplies the
# exact price feed consumed by the onchain market. Public Hermes works during
# the current migration window; configure a key before the provider's
# announced authentication cutoff. Never expose this key client-side.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=<server-only Pyth Hermes access token>

# Off-chain market data for STOCK markets (category "stocks" in
# app/lib/markets.ts: NVDA/GOOGL/SPACEX) comes from Hyperliquid's public
# "xyz" HIP-3 dex (app/lib/hyperliquid-market-data.ts) -- MARKET_DATA_PROVIDER
# above never applies to them. No API key, no account, no credit budget: it
# is a free, unauthenticated public endpoint. Override the base URL only for
# tests/local mocking:
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# HMAC secret for wallet session cookies (Sign-In-With-Solana). At least 16
# characters of high entropy. Wallet sign-in fails closed without it except on
# localhost previews, which use a fixed dev-only secret.
SESSION_SECRET=
