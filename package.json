{
  "name": "tend-markets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=vsol/.env --test --test-concurrency=1 tests/*.test.mjs",
    "test:vsol": "npm --prefix vsol run check",
    "test:web-smoke": "node --import tsx vsol/scripts/web-execution-smoke.ts",
    "test:http-smoke": "node --import tsx vsol/scripts/http-flow-smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:vsol",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "bn.js": "5.2.5",
    "jayson": {
      "uuid": "11.1.1"
    },
    "postcss": "8.5.10"
  },
  "type": "module"
}
